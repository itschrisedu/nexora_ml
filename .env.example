# ══════════════════════════════════════════════════════════════
# nexora_ml — Microservicio de Predicción de Demanda (FastAPI)
# ══════════════════════════════════════════════════════════════
# Variables de entorno requeridas:
#   NEXORA_API_URL   = URL del backend NestJS (ej: http://localhost:3000)
#   NEXORA_API_TOKEN = Token de servicio para autenticación M2M
#   ML_PORT          = Puerto del microservicio (default: 8001)
# ══════════════════════════════════════════════════════════════

NEXORA_API_URL=http://localhost:3000
NEXORA_API_TOKEN=nexora-ml-service-token
ML_PORT=8001
